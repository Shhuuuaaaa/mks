#!/bin/bash
set -euo pipefail

MODELE="$HOME/.local/bin/modele.sh"

if [[ ! -f "$MODELE" ]]; then
    echo "Error: Template file '$MODELE' not found!" >&2
    exit 1
fi

if [[ $# -eq 0 ]]; then
    echo "Error: No filename specified." >&2
    echo "Usage: mks <script_name.sh>" >&2
    exit 1
fi

CIBLE="$1"

if [[ -e "$CIBLE" ]]; then
    echo "Error: File '$CIBLE' already exists!" >&2
    exit 1
fi

cp "$MODELE" "$CIBLE"
chmod +x "$CIBLE"
nano "$CIBLE"